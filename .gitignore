# Terraform generated files
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
crash.*.log

# Terraform variable files containing secrets
*.tfvars
*.tfvars.json

# Keep Terraform lock file
!.terraform.lock.hcl

# Ignore everything inside Evidence
Evidence/*

# Allow Evidence subdirectories
!Evidence/*/

# Allow only .txt files inside Evidence
!Evidence/**/*.txt
